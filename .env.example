# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=wms

# --- SQL Server (db service) ---
MSSQL_SA_PASSWORD=
# One of: Developer, Express, Standard, Enterprise, EnterpriseCore
MSSQL_SA_PID=Developer
# Full connection string the api container uses to reach the db service —
# host must be "db" (the compose service name), not localhost.
CONNECTION_STRING=Server=db,1433;Database=WMS_DB;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True

# --- Redis (cache service) ---
REDIS_PASSWORD=

# --- JWT ---
JWTSETTINGS_SECRET=
JWTSETTINGS_ISSUER=WMS
JWTSETTINGS_AUDIENCE=WMS-Client
JWTSETTINGS_EXPIRY_IN_MINUTES=60

# --- CORS ---
# The deployed frontend's origin (scheme + host, no trailing slash).
ALLOWED_ORIGIN=http://localhost:5173

# --- SMTP (used for invite/reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_SENDER_NAME=Workspace Management System
SMTP_SENDER_EMAIL=

# --- Frontend build-time API base (docker-compose.yml's web service) ---
VITE_API_BASE_URL=/api

# --- docker-compose.local.yml overrides (host port mappings + dev environment) ---
DB_PORT=1433
API_PORT=5080
WEB_PORT=5173
ASPNETCORE_ENVIRONMENT=Development
